{
  "name": "@yourname/sync-client",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/main.js",
    "start:dev": "tsx src/main.ts",
    "electron": "tsc && electron dist/electron-main.js",
    "prepublishOnly": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "",
  "license": "ISC",
  "description": "A TypeScript-based file synchronization client with multi-threaded scanning",
  "keywords": [
    "sync",
    "file-sync",
    "typescript",
    "file-watcher"
  ],
  "dependencies": {
    "@prisma/client": "^6.18.0",
    "axios": "^1.13.2",
    "chokidar": "^4.0.3",
    "dotenv": "^17.2.3",
    "form-data": "^4.0.5",
    "mime-types": "^3.0.2",
    "sharp": "^0.34.5",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.10.1",
    "electron": "^39.2.7",
    "prisma": "^6.18.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
