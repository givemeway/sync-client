// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// https://www.prisma.io/docs/orm/prisma-client/queries/transactions
generator client {
  provider = "prisma-client-js"
  output = "../DB/prisma-client"
  previewFeatures = ["fullTextSearch","relationJoins"]
  binaryTargets = ["native", "debian-openssl-1.1.x","debian-openssl-3.0.x","darwin-arm64"]
}

datasource db {
  provider = "sqlite"
  url      ="file:./dev.db"
}

model File {
  uuid String @unique()
  path String
  filename String
  last_modified DateTime
  hashvalue String
  size BigInt
  dirID String
  inode String
  absPath String
  versions Int 
  origin String
  lastSyncedHashValue String
  conflictId String?
  directoryID Directory @relation(fields: [dirID],references: [uuid])
  @@unique([path,filename])
  @@index([path,filename]) 
}

model ConflictQueue {
  uuid String @unique()
  path String
  filename String
  last_modified DateTime
  hashvalue String
  lastSyncedHashValue String
  absPath String
  size BigInt
  inode String
  versions Int 
  origin String @unique()
  conflictId String @unique()
  @@unique([path,filename])
  @@index([path,filename]) 
}

model Directory {
  uuid String @unique()
  device String
  folder String
  path String
  created_at DateTime
  absPath String
  inode String
  @@unique([device,folder,path])
  files File[] 
  @@index([path])
}

model FileQueue {
  uuid String @unique()
  path String
  filename String
  last_modified DateTime
  hashvalue String
  size BigInt
  dirID String
  sync_status String
  inode String
  versions Int 
  origin String
  absPath String
  old_path String?
  old_filename String?
  lastSyncedHashValue String
  directoryID DirectoryQueue @relation(fields: [dirID],references: [uuid])
  @@unique([path,filename])
  @@index([path,filename]) 
}

model DirectoryQueue {
  uuid String @unique()
  device String
  folder String
  path String
  created_at DateTime
  sync_status String
  absPath String
  old_path String?
  inode String
  @@unique([device,folder,path])
  files FileQueue[] 
  @@index([path])
}
